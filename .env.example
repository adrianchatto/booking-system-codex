# Database — PostgreSQL connection string
# For local dev: postgresql://user:password@localhost:5432/bookright
# For Render: copy from your Render PostgreSQL dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/bookright"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Used to encrypt saved SMTP passwords. If omitted, NEXTAUTH_SECRET is used.
EMAIL_ENCRYPTION_KEY="your-secret-here-generate-with-openssl-rand-base64-32"

# For local dev
NEXTAUTH_URL="http://localhost:3000"
# For production on Coolify, set this to your root platform URL:
# NEXTAUTH_URL="https://bookingcodex.chattoweb.com"

# Root domain used for wildcard tenant routing, e.g. bright-windows.bookingcodex.chattoweb.com
NEXT_PUBLIC_ROOT_DOMAIN="bookingcodex.chattoweb.com"
